const _CHARSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
static var _cache := {}

static func frame_texture(frame_id: String) -> Texture2D:
	if _cache.has(frame_id):
		return _cache[frame_id]
	var data: Dictionary = FRAMES.get(frame_id, {})
	if data.is_empty():
		return null
	var palette: Array = data["palette"]
	var rows: Array = data["rows"]
	var img := Image.create(16, 32, false, Image.FORMAT_RGBA8)
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			var ch: String = row[x]
			if ch == ".":
				continue
			var idx: int = _CHARSET.find(ch)
			if idx >= 0 and idx < palette.size():
				img.set_pixel(x, y, palette[idx])
	img.resize(32, 64, Image.INTERPOLATE_NEAREST)
	var tex := ImageTexture.create_from_image(img)
	_cache[frame_id] = tex
	return tex
