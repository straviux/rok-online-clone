const _CHARSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
static var _cache := {}

static func get_texture(image_name: String) -> Texture2D:
	if _cache.has(image_name):
		return _cache[image_name]
	var data: Dictionary = IMAGES.get(image_name, {})
	if data.is_empty():
		return null
	var palette: Array = data["palette"]
	var rows: Array = data["rows"]
	var w: int = rows[0].length()
	var h: int = rows.size()
	var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
	for y in h:
		var row: String = rows[y]
		for x in row.length():
			var ch: String = row[x]
			if ch == ".":
				continue
			var idx: int = _CHARSET.find(ch)
			if idx >= 0 and idx < palette.size():
				img.set_pixel(x, y, palette[idx])
	var tex := ImageTexture.create_from_image(img)
	_cache[image_name] = tex
	return tex
