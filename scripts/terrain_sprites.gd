const _CHARSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
static var _cache := {}

static func get_image(tile_name: String) -> Image:
	var data: Dictionary = TILES.get(tile_name, {})
	if data.is_empty():
		return null
	var palette: Array = data["palette"]
	var rows: Array = data["rows"]
	var img := Image.create(32, 32, false, Image.FORMAT_RGBA8)
	for y in 32:
		var row: String = rows[y]
		for x in row.length():
			var ch: String = row[x]
			if ch == ".":
				continue
			var idx: int = _CHARSET.find(ch)
			if idx >= 0 and idx < palette.size():
				img.set_pixel(x, y, palette[idx])
	return img


static func get_texture(tile_name: String) -> Texture2D:
	if _cache.has(tile_name):
		return _cache[tile_name]
	var img: Image = get_image(tile_name)
	if img == null:
		return null
	var tex := ImageTexture.create_from_image(img)
	_cache[tile_name] = tex
	return tex
