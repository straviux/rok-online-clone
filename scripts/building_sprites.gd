const _CHARSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
static var _cache := {}

static func get_texture(building_name: String) -> Texture2D:
	if _cache.has(building_name):
		return _cache[building_name]
	var data: Dictionary = BUILDINGS.get(building_name, {})
	if data.is_empty():
		return null
	var palette: Array = data["palette"]
	var rows: Array = data["rows"]
	var width: int = rows[0].length()
	var height: int = rows.size()
	var img := Image.create(width, height, false, Image.FORMAT_RGBA8)
	for y in height:
		var row: String = rows[y]
		for x in row.length():
			var ch: String = row[x]
			if ch == ".":
				continue
			var idx: int = _CHARSET.find(ch)
			if idx >= 0 and idx < palette.size():
				img.set_pixel(x, y, palette[idx])
	var tex := ImageTexture.create_from_image(img)
	_cache[building_name] = tex
	return tex
