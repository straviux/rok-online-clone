const _CHARSET := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
static var _cache := {}

static func get_frame(monster: String, anim: String, idx: int) -> Texture2D:
	var key: String = "%s:%s:%d" % [monster, anim, idx]
	if _cache.has(key):
		return _cache[key]
	var data: Dictionary = MONSTERS.get(monster, {})
	if data.is_empty():
		return null
	var frames: Array = data.get(anim, [])
	if frames.is_empty():
		return null
	var rows: Array = frames[idx % frames.size()]
	var palette: Array = data["palette"]
	var img := Image.create(32, 32, false, Image.FORMAT_RGBA8)
	for y in 32:
		var row: String = rows[y]
		for x in row.length():
			var ch: String = row[x]
			if ch == ".":
				continue
			var pidx: int = _CHARSET.find(ch)
			if pidx >= 0 and pidx < palette.size():
				img.set_pixel(x, y, palette[pidx])
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
