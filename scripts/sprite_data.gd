static var _cache := {}

static func get_texture(sprite_name: String) -> Texture2D:
	if _cache.has(sprite_name):
		return _cache[sprite_name]
	var rows: Array = GRIDS.get(sprite_name, [])
	if rows.is_empty():
		return null
	var width := 0
	for row in rows:
		width = max(width, row.length())
	var height: int = rows.size()
	var img := Image.create(width, height, false, Image.FORMAT_RGBA8)
	for y in height:
		var row: String = rows[y]
		for x in row.length():
			var ch: String = row[x]
			if ch == ".":
				continue
			if PALETTE.has(ch):
				img.set_pixel(x, y, PALETTE[ch])
	var scale: int = SCALES.get(sprite_name, 1)
	if scale > 1:
		img.resize(width * scale, height * scale, Image.INTERPOLATE_NEAREST)
	var tex := ImageTexture.create_from_image(img)
	_cache[sprite_name] = tex
	return tex
